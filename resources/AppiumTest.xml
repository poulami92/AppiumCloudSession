<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AppiumTest">

<listeners>
   <listener class-name="TestUtility.Listeners"/>
</listeners>

<test name="LongPressTest"> 
  <classes>
    <class name = "AndroidAppiumTests.LongPressTest" />
  </classes>
</test>

<test name="ScrollToElementTest" enabled="true"> 
  <classes>
    <class name = "AndroidAppiumTests.scrollToElementTest" />
  </classes>
</test> 

<test name="KeyEventTest" enabled="true"> 
  <classes>
    <class name = "AndroidAppiumTests.KeyEventTest" />
  </classes>
</test> 
</suite> 
